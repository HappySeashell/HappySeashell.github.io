/************************* Nikki ************************/


/************************* About ************************/
.posts-collapse .post-content .collection-month {
  font-size: 1.2em;
  font-weight: bold;
  margin: 30px 2px 0;
  position: relative;
}
.posts-collapse .post-content .collection-month::before {
  background: #bbb;
  border: 1px solid #fff;
  left: -6px;
  position: absolute;
  top: 0.75em;
  transition: background 0.2s ease-in-out;
  border-radius: 50%;
  content: ' ';
  height: 6px;
  width: 6px;
}

.posts-collapse .post-content .collection-content {
  font-size: 1em;
  margin: 30px 20px 0;
  position: relative;
  background-color: $myyellow;
  border-radius: $myradius;
  padding: 10px;
  @media (prefers-color-scheme: dark) {
    background-color: $mypurple;
  }
}

/*进度条，借鉴自黑石博客*/

.progress {
	-moz-appearance: none;
	-webkit-appearance: none;
	border: none;
	border-radius: 290486px;
	display: block;
	height: 1rem;
	overflow: hidden;
	padding: 0;
	width: 100%;
}

.progress.red::-webkit-progress-bar {
	background-color: $myred-light;
}

.progress.yellow::-webkit-progress-bar {
	background-color: $myyellow-light
}

.progress.blue::-webkit-progress-bar {
	background-color: $myblue-light
}

.progress.green::-webkit-progress-bar {
	background-color: $mygreen-light
}

.progress.violet::-webkit-progress-bar {
	background-color: $myviolet-light
}

.progress::-webkit-progress-value {
	background-color: #4a4a4a;
}

.progress::-moz-progress-bar {
	background-color: #4a4a4a;
}

.progress::-ms-fill {
	background-color: #4a4a4a;
	border: none;
}

.progress.red::-webkit-progress-value {
	background-color: $myred;
}

.progress.red::-moz-progress-bar {
	background-color: $myred;
}

.progress.red::-ms-fill {
	background-color: $myred;
}

.progress.red:indeterminate {
	background-image: linear-gradient(to right, $myred 30%, #ededed 30%);
}

.progress.blue::-webkit-progress-value {
	background-color: $myblue;
}

.progress.blue::-moz-progress-bar {
	background-color: $myblue;
}

.progress.blue::-ms-fill {
	background-color: $myblue;
}

.progress.blue:indeterminate {
	background-image: linear-gradient(to right, $myblue 30%, #ededed 30%);
}

.progress.yellow::-webkit-progress-value {
	background-color: $myyellow;
}

.progress.yellow::-moz-progress-bar {
	background-color: $myyellow;
}

.progress.yellow::-ms-fill {
	background-color: $myyellow;
}

.progress.yellow:indeterminate {
	background-image: linear-gradient(to right, $myyellow 30%, #ededed 30%);
}

.progress.violet::-webkit-progress-value {
	background-color: $myviolet;
}

.progress.violet::-moz-progress-bar {
	background-color: $myviolet;
}

.progress.violet::-ms-fill {
	background-color: $myviolet;
}

.progress.violet:indeterminate {
	background-image: linear-gradient(to right, $myviolet 30%, #ededed 30%);
}

.progress.green::-webkit-progress-value {
	background-color: $mygreen;
}

.progress.green::-moz-progress-bar {
	background-color: $mygreen;
}

.progress.green::-ms-fill {
	background-color: $mygreen;
}

.progress.green:indeterminate {
	background-image: linear-gradient(to right, $mygreen 30%, #ededed 30%);
}

.progress:indeterminate {
	-webkit-animation-duration: 1.5s;
	animation-duration: 1.5s;
	-webkit-animation-iteration-count: infinite;
	animation-iteration-count: infinite;
	-webkit-animation-name: moveIndeterminate;
	animation-name: moveIndeterminate;
	-webkit-animation-timing-function: linear;
	animation-timing-function: linear;
	background-color: #ededed;
	background-image: linear-gradient(to right, #4a4a4a 30%, #ededed 30%);
	background-position: top left;
	background-repeat: no-repeat;
	background-size: 150% 150%;
}

.progress:indeterminate::-webkit-progress-bar {
	background-color: transparent;
}

.progress:indeterminate::-moz-progress-bar {
	background-color: transparent;
}

@-webkit-keyframes moveIndeterminate {
	from {
		background-position: 200% 0;
	}
	to {
		background-position: -200% 0;
	}
}

@keyframes moveIndeterminate {
	from {
		background-position: 200% 0;
	}
	to {
		background-position: -200% 0;
	}
}

/************************* Waline Comment ************************/

/* comment-圆角 */
.comments {
  border-radius: $myradius !important;
}

/* comment-评论超链接下划线 */
.comments a {
  border-bottom: none;  
}

/* comment-输入框背景图片 */
