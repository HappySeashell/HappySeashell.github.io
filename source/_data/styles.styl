.link-preview
    display:flex
    overflow: hidden;
    position: relative;
    margin-bottom: 20px;
    padding: 15px;
    border-width: 0;
    border-radius: $myradius;
    border: 1px solid #efefef;
    background: #fafafa;
    @media (prefers-color-scheme: dark) {
		    border: 1px var(--text-color) solid;
        background: transparent;
      }
  .hbc-link-wrap
    position: relative;
    .hbc-link
      .hbc-card
        .hbc-info
          .fancybox
            border-bottom: 0px solid;
          .hbc-favicon
            height: 16px;
            width: 16px;
            margin: 0 6px !important;
            border: none;
            vertical-align: middle;
            display: inline !important;
          .hbc-site-name
            font-size: 10px;
            font-style: italic;
            display: inline !important;
      .hbc-contents
        overflow: hidden;
        display: flex;
        .hbc-thumbnail
          max-width: 100px;
          max-height: 100px;
          padding: 0;
          margin: 0 6px 4px 4px;
        .hbc-text
          flex: 1;
        .hbc-title
          font-size: 20px;
          font-weight: bold;
          overflow: hidden;
        .hbc-url
          // display: none;
          font-size: 10px;
        .hbc-description
          margin: 0;
          font-size: 12px;
          padding: 0;
          overflow: hidden;

.link-preview:hover {
  background: var(--table-row-hover-bg-color);
  }
.link-preview:hover .hbc-link {
  color:var(--text-color);
  }

/************************ Button ***************************/

/* button-back2top */
.back-to-top {
  background: $btn-default-bg;

  opacity: .8;
  font-weight: bold;
  font-size: 0.8em;
  border-radius: 1em;
}

/* button-reward */
.donations {
  text-align: center;
  padding: 1.5rem;
  margin-top: 25px;
}

.donation-label {
  margin-bottom: 1rem;
  letter-spacing: 1px;
  font-size: .9em;
  font-weight: bold;
  color: var(--text-color);
}

.afdian-button {
  box-shadow: $box-shadow;
  height: 2.5em;
  line-height: 1.5;
  box-sizing: border-box;
  border-color: transparent;
  padding: .5em .75em;
  border-radius: 4px;
  font-size: .9em;
  color: white;
  background-color: #946ce6;

  &:hover {
    color: white;
    border-color: transparent;
  }
}

/* 修改选中字符的颜色 */
::selection {
  background: rgba(0, 149, 255, 0.2);
  color: var(--blockquote-color);
}

/****************** Pagination & Footer ********************/

/* pagination-删去页码框 */
.pagination {
  border: none !important;
  background: none !important;
  box-shadow: none !important;
}

/* pagination-页码按钮 */
.pagination .prev,
.pagination .next,
.pagination .page-number {
  border: none;
  border-radius: 1em;

  &:hover {
    color: white;
    background: $btn-default-hover-bg;
    btn-shadow-hover-only();
  }
}

/* pagination-当前页码 */
.pagination .page-number.current {
  background: $btn-default-bg;
  btn-shadow-only();
}

/* footer */
.footer {
  margin: 0px 0 0px 0;
  color: var(--blockquote-color);

}

/************************ Overview *************************/

/* categories */
+mobile() {
  .category-all-page .category-list-item {
    margin: 10px 40px;
  }

  .category-all-page .category-all ul {
    list-style-type: disc;
  }
}

+tablet-desktop() {
  .category-all-page .category-list-item {
    margin: 0px 12px;
  }

  ul.category-list {
    text-align: center;
  }

  li.category-list-item {
    display: inline-block;
    padding: 0px 0px;
  }

  li.category-list-item a {
    line-height: 5;
    word-break: keep-all;
    padding: 5px 10px;
    font-weight: bold;
    color: white;
    background: $btn-default-bg;
    border-bottom: none;
    border-radius: $myradius;
    btn-shadow();

    &:hover {
      text-decoration: none;
    }
  }
}
