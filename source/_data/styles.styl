// Custom styles.
/************************* Header **************************/

/* header-隐藏顶部线条 */
.headband {
  display: none;
}

/* header-顶部空白 */
.header, .main-inner {
  margin-top: 0px;

  +mobile() {
    margin-top: 0;
  }
}

/* 圆角 */
.header-inner, //顶部圆角
.sidebar-inner { //侧边头像圆角
  border-radius: $myradius;
}

// .site-brand-container {
//   border-radius: $myradius $myradius $myradius $myradius;

//   +mobile() {
//     border-radius: 0 0 $myradius $myradius;
//   }
// }

/* header-页面背景。NexT 8.28 将 header 放进全宽的 .column。 */
.column {
  background: linear-gradient(to left, $mypurple-deep, $myyellow);
  background-position: 70% 20%;
  background-size: cover;
  @media (prefers-color-scheme: dark) {
    background-image: url($site-brand-bg-dark-url);
  }
}

header.header {
  background: transparent;
}

body {
  background: white;
  @media (prefers-color-scheme: dark) {
  background: $myblack;
  }
}

/* Day of Mourning */
if (hexo-config('gray')) {
  html {
    -webkit-filter: grayscale(100%);
    -moz-filter: grayscale(100%);
    -ms-filter: grayscale(100%);
    -o-filter: grayscale(100%);
    filter: grayscale(100%);
    filter: gray;
  }
  @media (prefers-color-scheme: light) {
    body {
      background-image: url($body-bg-gray-url);
    }
  }
}

/************************ Sidebar **************************/
/* 主题颜色 */
.sidebar-toc-active .sidebar-nav-toc, .sidebar-overview-active .sidebar-nav-overview {
    border-bottom-color: $myyellow-deep;
    color: $myyellow-deep;
}
.sidebar-toc-active .sidebar-nav-toc:hover,
.sidebar-overview-active .sidebar-nav-overview:hover {
  color: $myyellow-deep;
}

.sidebar-toggle{
  bottom: 60px
}

/* sidebar-毛玻璃 */
.sidebar {
  background: rgba(34,34,34,0.4);
  -webkit-backdrop-filter: blur(4px);
  -moz-backdrop-filter: blur(4px);
  -ms-backdrop-filter: blur(4px);
  -o-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  box-shadow: inset 0 0px 26px #f9f9f90d;
  // @media (prefers-color-scheme: dark) {
  //   background: rgba(34,34,34,0.4);
  // }
}

body{
  background-color: $myblack;
}
.main{
  background-color: white;
  @media (prefers-color-scheme: dark) {
    background-color: $myblack;
  }
}
