  border-bottom-color: transparent;
  font-weight: bold;
  font-size: 20px;
}
li.custom-category-list-item {
  list-style: none;
  font-size: 20px;
  color: $myyellow-deep;
  // display: inline-block;
  // padding: 0px 0px;
}
#custom-file-icon {
  color: $myyellow;
  }
li.custom-category-post-item {
