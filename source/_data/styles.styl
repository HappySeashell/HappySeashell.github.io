.custom-chart{
  width:81%;
  height:300px
}
/* tags */
.tag-cloud-title{
  font-size: 1.2em;
  }

.tag-cloud a, //标签云
.posts-expand .post-tags a { //文章末标签
  padding: 2px 10px;
  margin: 8px;
  background: $whitesmoke;
  border-bottom: none;
  border-radius: 15px;
  font-size: 1.1em !important;
  btn-shadow();

  &:hover {
    color: white !important;
    text-decoration: none;
  }

  @media (prefers-color-scheme: dark) {
